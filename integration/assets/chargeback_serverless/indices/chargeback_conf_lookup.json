{
  "settings": {
    "index": {
      "mode": "lookup",
      "codec": "best_compression",
      "mapping": {
        "source": {
          "mode": "synthetic"
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "@timestamp": { "type": "date" },
      "config_join_key": { "type": "keyword" },
      "conf_start_date": { "type": "date" },
      "conf_end_date": { "type": "date" },
      "conf_chargeable_unit_rate": { "type": "double" },
      "conf_chargeable_unit_rate_unit": { "type": "keyword" },
      "conf_currency_symbol": { "type": "keyword" },
      "conf_chargeable_unit_rate_symbol": {
        "type": "alias",
        "path": "conf_currency_symbol"
      },
      "total_ecu": {
        "type": "alias",
        "path": "conf_chargeable_unit_rate"
      },
      "conf_ecu_rate": {
        "type": "alias",
        "path": "conf_chargeable_unit_rate"
      },
      "conf_ecu_rate_unit": {
        "type": "alias",
        "path": "conf_chargeable_unit_rate_unit"
      }
    }
  }
}
